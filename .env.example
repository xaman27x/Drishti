# Copy to .env. This is a loopback-only, single-host demonstration deployment.
DRISHTI_ENVIRONMENT=local
DRISHTI_ADAPTER_MODE=durable
DRISHTI_LOG_LEVEL=INFO
DRISHTI_MAX_EVENT_BYTES=1048576
DRISHTI_KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
DRISHTI_KAFKA_ARCHIVED_TOPIC=drishti.raw.archived.v1
DRISHTI_KAFKA_CONSUMER_GROUP=drishti-normalizer-v1
DRISHTI_MINIO_ENDPOINT=minio:9000
DRISHTI_MINIO_ACCESS_KEY=drishti
DRISHTI_MINIO_SECRET_KEY=drishti-local-demo-change-me
DRISHTI_MINIO_BUCKET=drishti-raw-evidence
DRISHTI_MINIO_RESULTS_BUCKET=drishti-results
DRISHTI_MINIO_SECURE=false
DRISHTI_STATE_DIR=/state
DRISHTI_OUTBOX_INTERVAL_SECONDS=2
DRISHTI_WORKER_STALE_SECONDS=30
DRISHTI_DRIFT_BASELINE_SIZE=4
DRISHTI_DRIFT_WINDOW_SIZE=2
DRISHTI_DEMO_ADMIN_ENABLED=true
DRISHTI_APPROVE_BUILTINS=false
DRISHTI_API_PORT=8080
DRISHTI_FRONTEND_PORT=5173
DRISHTI_MINIO_PORT=9000
DRISHTI_MINIO_CONSOLE_PORT=9001
